{
	"name": "satellite-oracle-svelte",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "bash -lc 'mkdir -p logs; LOG_FILE=\"logs/dev-$(date +%Y%m%d-%H%M%S).log\"; echo \"[dev-log] $LOG_FILE\"; npm run dev:raw 2>&1 | tee -a \"$LOG_FILE\"; exit ${PIPESTATUS[0]}'",
		"dev:raw": "vite dev",
		"prebuild": "svelte-kit sync",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.2.0",
		"@types/node-schedule": "^2.1.8",
		"@types/papaparse": "^5.5.2",
		"@types/three": "^0.185.4",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"node-schedule": "^2.1.1",
		"openai": "^7.5.0",
		"papaparse": "^5.6.0",
		"satellite.js": "^7.1.0",
		"three": "^0.185.1"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	},
	"overrides": {
		"cookie": "0.7.2"
	}
}
