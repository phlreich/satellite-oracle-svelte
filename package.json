{
	"name": "satellite-oracle-svelte",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "bash -lc 'mkdir -p logs; LOG_FILE=\"logs/dev-$(date +%Y%m%d-%H%M%S).log\"; echo \"[dev-log] $LOG_FILE\"; npm run dev:raw 2>&1 | tee -a \"$LOG_FILE\"; exit ${PIPESTATUS[0]}'",
		"dev:raw": "vite dev",
		"prebuild": "svelte-kit sync",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"@types/node-schedule": "^2.1.8",
		"@types/papaparse": "^5.5.2",
		"@types/three": "^0.187.0",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tslib": "^2.9.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"node-schedule": "^2.1.2",
		"openai": "^7.47.0",
		"papaparse": "^5.7.0",
		"satellite.js": "^7.1.0",
		"three": "^0.187.0"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	},
	"overrides": {
		"minimatch": "^11.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
